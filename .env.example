# Database
DATABASE_URL="postgresql://user:password@localhost:5432/deploypulse?schema=public"

# Auth (NextAuth.js)
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional - set to enable social login)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# External APIs
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"
VERCEL_WEBHOOK_SECRET="your-vercel-webhook-secret"
NETLIFY_WEBHOOK_SECRET="your-netlify-webhook-secret"

# Feature Flags
ENABLE_BILLING="false"
ENABLE_TEAMS="false"
